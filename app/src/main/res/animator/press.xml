<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.96" android:duration="120" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_quad" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.96" android:duration="120" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_quad" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="@dimen/press_depth" android:duration="120" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="320" android:valueType="floatType" android:interpolator="@android:interpolator/overshoot" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="320" android:valueType="floatType" android:interpolator="@android:interpolator/overshoot" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0" android:duration="200" android:valueType="floatType" />
        </set>
    </item>
</selector>
